 #[derive(Debug, Clone)]
 pub struct LingoCallback {
+    /// The immutable dirplayer owner bound to the Ruffle instance that
+    /// registered this callback. This stays separate from LocalConnection's
+    /// owner plumbing and is carried back on every callback event.
+    pub owner_key: String,
