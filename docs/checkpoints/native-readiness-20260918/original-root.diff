+            let mut handle = reset_slot.borrow_mut().take();
+            let succeeded = handle
+                .as_mut()
+                .map(|handle| handle.reset().is_ok())
+                .unwrap_or(false);
+            if let Some(handle) = handle {
+                reset_slot.borrow_mut().replace(handle);
+            }
+            reset_seen_for_closure.set(succeeded);
