+        }
+        drop(positive_owner_guard);
+        drop(positive_capability);
+        drop(positive);
+
+        press_count.set(0);
+        let (root_b, capability_b, owner_guard_b, _root_b_container) =
+            prepare_pointer_player(include_bytes!("../../tests/fixtures/flash_mouse_b.swf"))
+                .await?;
