+        let mut player = make_player(OwnerToken::new(super::ownership::OwnerKey {
+            session: 98,
+            player: 1,
+            generation: 1,
+        }));
+        player.movie.score.channels = vec![SpriteChannel::new(0), SpriteChannel::new(1)];
+        player.movie.score.channels[1].sprite.member = Some(CastMemberRef {
+            cast_lib: 1,
