+        run_owned_mouse_down(session, player_id, owner, 250, 200)
+            .await
+            .map_err(|error| format!("positive-control mouse down failed: {error}"))?;
+        if press_count.get() != 1 {
+            return Err(format!(
+                "positive-control press counter was {}",
+                press_count.get()
