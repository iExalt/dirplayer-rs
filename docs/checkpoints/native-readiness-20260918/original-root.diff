+            "https://fixture.invalid/",
+        )
+            .unwrap_or_else(|error| panic!("{name} did not parse through read_director_file_bytes: {error}"));
+        assert_eq!(parsed.base_path.as_str(), "https://fixture.invalid/", "{name} base URL");
