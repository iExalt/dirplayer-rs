+#[derive(Debug, Default)]
+pub struct LingoCallbackRegistry {
+    callbacks: Vec<LingoCallback>,
+}
+
+pub type SharedLingoCallbackRegistry = Rc<RefCell<LingoCallbackRegistry>>;
+
+impl LingoCallbackRegistry {
+    pub fn register(&mut self, callback: LingoCallback) {
+        self.callbacks.retain(|existing| {
+            !(existing.owner_key == callback.owner_key
+                && existing.sprite_num == callback.sprite_num
+                && existing.instance_generation == callback.instance_generation
+                && existing.method_name == callback.method_name
+                && existing.lingo_cast_lib == callback.lingo_cast_lib
+                && existing.lingo_cast_member == callback.lingo_cast_member
+                && existing.lingo_handler == callback.lingo_handler)
+        });
+        self.callbacks.push(callback);
+    }
+
+    pub fn snapshot(&self) -> Vec<LingoCallback> {
+        self.callbacks.clone()
+    }
+
+    pub fn clear(&mut self) {
+        self.callbacks.clear();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{LingoCallback, LingoCallbackRegistry, SharedLingoCallbackRegistry};
+    use std::cell::RefCell;
+    use std::rc::Rc;
+
+    fn callback(
+        owner_key: &str,
+        sprite_num: i32,
+        instance_generation: u64,
+        movie_clip_path: &str,
+        flash_cast_member: i32,
+    ) -> LingoCallback {
+        LingoCallback {
+            owner_key: owner_key.to_owned(),
+            sprite_num,
+            instance_generation,
+            movie_clip_path: movie_clip_path.to_owned(),
+            method_name: "onClick".to_owned(),
+            lingo_cast_lib: 2,
+            lingo_cast_member: 3,
+            lingo_handler: "handleClick".to_owned(),
+            flash_cast_lib: 4,
+            flash_cast_member,
+        }
+    }
+
+    fn shared_registry() -> SharedLingoCallbackRegistry {
+        Rc::new(RefCell::new(LingoCallbackRegistry::default()))
+    }
+
+    #[test]
+    fn callback_registries_are_isolated_for_identical_names() {
+        let first = shared_registry();
+        let second = shared_registry();
+        first
+            .borrow_mut()
+            .register(callback("owner-a", 7, 11, "first", 8));
+        second
+            .borrow_mut()
+            .register(callback("owner-b", 7, 11, "second", 9));
+
+        let first_snapshot = first.borrow().snapshot();
+        let second_snapshot = second.borrow().snapshot();
+        assert_eq!(first_snapshot.len(), 1);
+        assert_eq!(second_snapshot.len(), 1);
+        assert_eq!(first_snapshot[0].owner_key, "owner-a");
+        assert_eq!(second_snapshot[0].owner_key, "owner-b");
+        assert_eq!(first_snapshot[0].movie_clip_path, "first");
+        assert_eq!(second_snapshot[0].movie_clip_path, "second");
+    }
+
+    #[test]
+    fn same_binding_replaces_target_without_stale_duplicates() {
+        let mut registry = LingoCallbackRegistry::default();
+        registry.register(callback("owner-a", 7, 11, "old-target", 8));
+        registry.register(callback("owner-a", 7, 11, "new-target", 12));
+
+        let snapshot = registry.snapshot();
+        assert_eq!(snapshot.len(), 1);
+        assert_eq!(snapshot[0].movie_clip_path, "new-target");
+        assert_eq!(snapshot[0].flash_cast_member, 12);
+    }
+
+    #[test]
+    fn clearing_one_registry_does_not_clear_a_sibling() {
+        let first = shared_registry();
+        let second = shared_registry();
+        first
+            .borrow_mut()
+            .register(callback("owner-a", 7, 11, "first", 8));
+        second
+            .borrow_mut()
+            .register(callback("owner-b", 7, 11, "second", 9));
+
+        first.borrow_mut().clear();
+
+        assert!(first.borrow().snapshot().is_empty());
+        assert_eq!(second.borrow().snapshot().len(), 1);
+        assert_eq!(second.borrow().snapshot()[0].owner_key, "owner-b");
+    }
+
+    #[test]
+    fn snapshot_allows_reentrant_registration_and_keeps_captured_metadata() {
+        let registry = shared_registry();
+        registry
+            .borrow_mut()
+            .register(callback("owner-a", 7, 11, "before-reentry", 8));
+
+        // Object::call follows this same order: clone the entries, release the
+        // RefCell borrow, then permit registration during host reentry.
+        let snapshot = registry.borrow().snapshot();
+        registry
+            .borrow_mut()
+            .register(callback("owner-a", 7, 11, "after-reentry", 10));
+
+        assert_eq!(snapshot.len(), 1);
+        assert_eq!(snapshot[0].owner_key, "owner-a");
+        assert_eq!(snapshot[0].sprite_num, 7);
+        assert_eq!(snapshot[0].instance_generation, 11);
+        assert_eq!(snapshot[0].movie_clip_path, "before-reentry");
+        assert_eq!(registry.borrow().snapshot()[0].movie_clip_path, "after-reentry");
+    }
+}
