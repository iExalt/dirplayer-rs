+/// Invoke an owner-scoped JS object method. The session is borrowed only for
+/// argument conversion and result allocation; the interpreter call itself is
+/// outside the VM borrow so a JS callback may re-enter the same session.
+pub(crate) fn invoke_js_object_method_explicit(
+    session: &crate::player::session::RuntimeSessionHandle,
+    player_id: crate::player::session::PlayerId,
+    owner: &crate::player::ownership::OwnerToken,
+    id: u32,
+    name: &str,
+    args: &[DatumRef],
+) -> Option<Result<DatumRef, String>> {
+    let (runtime, object) = session.borrow().js_lingo_registry().object(player_id, owner, id)?;
+    let callee = resolve_js_callable(&object, name)?;
+    let runtime_for_conversion = runtime.clone();
+    let js_args = match session.borrow_mut().with_player_js(player_id, |mut context, registry| {
+        if !owner.same_identity(&context.player.owner) || !owner.is_arena_live() {
+            return Err(JsError::new("stale or foreign Director player"));
+        }
+        let mut conversion = JsConversionContext {
+            registry,
+            runtime: &runtime_for_conversion,
+            session: Rc::downgrade(session),
+            player_id,
+            owner: owner.clone(),
+        };
+        args.iter()
+            .map(|arg| datum_ref_to_js_value_with_context(context.player, context.symbols, &mut conversion, arg))
+            .collect::<Result<Vec<_>, _>>()
+    }) {
+        Some(Ok(values)) => values,
+        Some(Err(error)) => return Some(Err(error.message)),
+        None => return Some(Err("stale or foreign Director player".to_owned())),
+    };
+    // Method calls bind `this` to the receiver that supplied the callable,
+    // even when lookup walked its prototype chain. A synchronous native
+    // callback cannot safely re-enter the same interpreter and preserve a
+    // nested result, so report that boundary explicitly instead of returning
+    // a fabricated success or queueing an unbounded fire-and-forget call.
+    let this_value = JsValue::Object(object.clone());
+    let result = match runtime.try_borrow_mut() {
+        Ok(mut runtime_ref) => {
+            runtime_ref.invoke(&callee, js_args, this_value)
+        }
+        Err(_) => return Some(Err(
+            "reentrant JS object call requires a deferred evaluator turn".to_owned(),
+        )),
+    };
+    let result = match result {
+        Ok(value) => value,
+        Err(error) => return Some(Err(error.message)),
+    };
+    let runtime_for_conversion = runtime.clone();
+    Some(match session.borrow_mut().with_player_js(player_id, |mut context, registry| {
+        if !owner.same_identity(&context.player.owner) || !owner.is_arena_live() {
+            return Err(JsError::new("stale or foreign Director player"));
+        }
+        let mut conversion = JsConversionContext {
+            registry,
+            runtime: &runtime_for_conversion,
+            session: Rc::downgrade(session),
+            player_id,
+            owner: owner.clone(),
+        };
+        js_value_to_datum_ref_with_context(context.player, context.symbols, &mut conversion, &result)
+    }) {
+        Some(Ok(value)) => Ok(value),
+        Some(Err(error)) => Err(error.message),
+        None => Err("stale or foreign Director player".to_owned()),
+    })
+}
