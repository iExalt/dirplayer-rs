+            .dyn_into::<js_sys::Function>()?,
+    ));
+    let owner = session
+        .borrow_mut()
+        .with_player(player_id, |context| context.player.owner.clone())
+        .ok_or_else(|| JsValue::from_str("failed to capture guard-test owner"))?;
