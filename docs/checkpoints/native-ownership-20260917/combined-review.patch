+  }
+  if (!validFlashGeneration(expectedGeneration)) {
+    return flashOwnedFailure('invalid-generation');
+  }
+  if (host.disposed || flashOwnerHosts.get(host.ownerKey) !== host) {
+    return flashOwnedFailure('disposed-owner');
+  }
